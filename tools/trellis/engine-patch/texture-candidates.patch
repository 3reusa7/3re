+    } catch (const std::exception& e) { fprintf(stderr, "[tex-replay] texture flow: %s\n", e.what()); return 1; }
+    for (int n = 0; n < tN; ++n) for (int c = 0; c < 32; ++c) texlat[(size_t)c + 32*n] = texlat[(size_t)c + 32*n]*TEX_STD[c] + TEX_MEAN[c];
