+// ---- 3re texture candidates (fork of 7a80638a) ------------------------------------------------
+// A texture session holds exactly what the TRELLIS.2 res-512 texture flow and decoder read: the
+// shape SLAT (coords + normalized feats), the DINOv3 conditioning, the shape decoder's subdivision
+// masks, the decoded voxel coords, and the sampler's RNG state when the texture stage began (so a
+// replay with that state must reproduce the run's own PBR volume bit for bit).
+namespace texsession {
+constexpr char MAGIC[8] = {'P','3','D','T','E','X','S','1'};
+struct Session {
+    std::vector<std::array<int,3>> shc, coords;
+    std::vector<float> slat_norm, cond;
+    std::vector<std::vector<uint8_t>> subs;
+    int Lc = 0, res = 0;
+    std::string rng_state;
+};
+static bool wr(FILE* f, const void* p, size_t n) { return n == 0 || fwrite(p, 1, n, f) == n; }
+static bool rd(FILE* f, void* p, size_t n) { return n == 0 || fread(p, 1, n, f) == n; }
+static bool write(const char* path, const Session& s) {
+    FILE* f = fopen(path, "wb");
+    if (!f) return false;
+    const uint32_t hdr[7] = {1u, (uint32_t)s.shc.size(), (uint32_t)s.Lc, 1024u, (uint32_t)s.coords.size(),
+                             (uint32_t)s.res, (uint32_t)s.subs.size()};
+    const uint32_t rl = (uint32_t)s.rng_state.size();
+    bool ok = wr(f, MAGIC, 8) && wr(f, hdr, sizeof hdr) && wr(f, &rl, 4) && wr(f, s.rng_state.data(), rl) &&
+              wr(f, s.shc.data(), s.shc.size() * 12) && wr(f, s.slat_norm.data(), s.slat_norm.size() * 4) &&
+              wr(f, s.cond.data(), s.cond.size() * 4);
+    for (const auto& m : s.subs) {
+        const uint64_t n = m.size();
+        ok = ok && wr(f, &n, 8) && wr(f, m.data(), m.size());
+    }
+    ok = ok && wr(f, s.coords.data(), s.coords.size() * 12);
+    return fclose(f) == 0 && ok;
+}
+static bool read(const char* path, Session& s, std::string& err) {
+    std::error_code ec;
+    const uint64_t file_size = std::filesystem::file_size(path, ec);
+    if (ec) { err = "cannot open texture session"; return false; }
+    FILE* f = fopen(path, "rb");
+    if (!f) { err = "cannot open texture session"; return false; }
+    char magic[8]; uint32_t hdr[7] = {}, rl = 0;
+    bool ok = rd(f, magic, 8) && memcmp(magic, MAGIC, 8) == 0 && rd(f, hdr, sizeof hdr) && hdr[0] == 1u && hdr[3] == 1024u &&
+              hdr[1] > 0 && hdr[1] < (1u << 22) && hdr[2] > 0 && hdr[2] <= 16384 && hdr[4] > 0 && hdr[4] < (1u << 26) &&
+              hdr[6] <= 8 && rd(f, &rl, 4) && rl < 65536;
+    // Everything the header promises must fit in the file before anything is allocated.
+    ok = ok && 8 + 28 + 4 + uint64_t(rl) + uint64_t(hdr[1]) * (12 + 128) + uint64_t(hdr[2]) * 4096 + uint64_t(hdr[4]) * 12 <= file_size;
+    if (!ok) { fclose(f); err = "not a texture session (magic/version/bounds)"; return false; }
+    s.rng_state.resize(rl); s.shc.resize(hdr[1]); s.slat_norm.resize((size_t)hdr[1] * 32);
+    s.Lc = (int)hdr[2]; s.cond.resize((size_t)hdr[2] * 1024); s.res = (int)hdr[5]; s.subs.resize(hdr[6]);
+    ok = rd(f, s.rng_state.data(), rl) && rd(f, s.shc.data(), s.shc.size() * 12) &&
+         rd(f, s.slat_norm.data(), s.slat_norm.size() * 4) && rd(f, s.cond.data(), s.cond.size() * 4);
+    for (auto& m : s.subs) {
+        uint64_t n = 0;
+        ok = ok && rd(f, &n, 8) && n <= file_size;
+        if (!ok) break;
+        m.resize((size_t)n);
+        ok = rd(f, m.data(), m.size());
+    }
+    s.coords.resize(hdr[4]);
+    ok = ok && rd(f, s.coords.data(), s.coords.size() * 12);
+    char extra;
+    ok = ok && fread(&extra, 1, 1, f) == 0;  // nothing after the coords
+    fclose(f);
+    if (!ok) err = "texture session truncated or malformed";
+    return ok;
+}
