+    const std::vector<float> neg(s.cond.size(), 0.0f);
+    std::vector<float> texlat;
+    try {
+        trellis::Model m = trellis::Model::load(cfg.models + "/tex_flow_512.gguf", cfg.gpu);
+        if (m.try_get("blocks.0.cross_attn.proj_linear.weight"))
+            throw std::runtime_error("--model trellis but the checkpoint has cross_attn.proj_linear");
+        trellis::DiTParams p; p.in_ch = 64; p.out_ch = 32; p.d_cond = 1024; p.cast_f32 = F32;
