+    // The run's POST dump: header, mesh, coords must match the session's voxels exactly.
+    FILE* pf = fopen(cfg.tex_post_from.c_str(), "rb");
+    if (!pf) { fprintf(stderr, "[tex-replay] cannot open %s\n", cfg.tex_post_from.c_str()); return 1; }
+    int32_t ph[4] = {};
