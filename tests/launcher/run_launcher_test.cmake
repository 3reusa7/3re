# ctest driver: cmake -DLAUNCHER=... -DTARGET=... -DOUT=... -DCASE=forwards|missing -P run_launcher_test.cmake
if(CASE STREQUAL "forwards")
  set(ENV{THREERE_LAUNCH_TARGET} "${TARGET}")
  set(ENV{THREERE_ECHO_OUT} "${OUT}")
  file(REMOVE "${OUT}")
  execute_process(COMMAND "${LAUNCHER}" --a "b c" RESULT_VARIABLE code)
  if(NOT code EQUAL 7)
    message(FATAL_ERROR "launcher exit code ${code}, expected the target's 7")
  endif()
  file(READ "${OUT}" got)
  if(NOT got STREQUAL "--a \"b c\"")
    message(FATAL_ERROR "forwarded arguments [${got}], expected [--a \"b c\"]")
  endif()
elseif(CASE STREQUAL "missing")
  set(ENV{THREERE_LAUNCH_TARGET} "${OUT}.does-not-exist.exe")
  set(ENV{THREERE_LAUNCH_NO_UI} "1")
  execute_process(COMMAND "${LAUNCHER}" RESULT_VARIABLE code)
  if(NOT code EQUAL 9)
    message(FATAL_ERROR "launcher exit code ${code} for a missing app, expected 9")
  endif()
endif()
